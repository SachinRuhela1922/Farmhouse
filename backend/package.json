{
  "name": "farmhouse-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node scripts/seed.js",
    "set-admin": "node scripts/set-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "dev:memory": "node --env-file-if-exists=.env scripts/dev-memory.js",
    "check": "node scripts/check-config.js",
    "seed:demo": "node scripts/seed-demo.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}

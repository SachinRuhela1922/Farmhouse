# ---------------- Server ----------------
NODE_ENV=
PORT=
# Frontend origin(s) allowed by CORS (comma-separated). Also used for links in emails.
CLIENT_URL=

# ---------------- MongoDB Atlas ----------------
# Atlas → Database → Connect → Drivers. Include the database name (e.g. /farmhouse).
MONGODB_URI=

# ---------------- JWT ----------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# Cookies: keep "lax" when the frontend proxies /api (same site). Use "none" + COOKIE_SECURE=true
# when frontend and API are on different domains.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------------- Google sign-in (Firebase Auth only) ----------------
# Just the Firebase project id — no service account needed to verify ID tokens.
FIREBASE_PROJECT_ID=

# ---------------- Email (SMTP) ----------------
# Any SMTP provider: Gmail (app password), Brevo, SendGrid, Mailgun, Zoho…
# Leave SMTP_HOST empty to disable sending (links are then printed to the server console in development).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Willowmere Farmhouse <no-reply@your-domain.com>"

# ---------------- Razorpay (test mode first) ----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Run the in-process maintenance job (disable if you run several API instances)
RUN_JOBS=true

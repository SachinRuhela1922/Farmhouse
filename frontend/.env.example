# ---------------- Backend API ----------------
# Leave empty in development (Vite proxies /api → http://localhost:5000).
# In production set it to your API origin if the API is on another domain, e.g. https://api.your-domain.com
VITE_API_URL=
# Dev proxy target (optional)
VITE_DEV_API_TARGET=http://localhost:5000

# ---------------- Google sign-in (Firebase Auth only) ----------------
# Firebase Console → Project settings → Your apps → Web app. Public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Public site URL — used for sitemap.xml and canonical links
VITE_SITE_URL=https://your-domain.com
